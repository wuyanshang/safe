# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# OpenAI API配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Elasticsearch配置
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your-password

# Embedding模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PATH=./models/bge-large-zh-v1.5

# LLM配置
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# 召回配置
BM25_TOP_K=10
VECTOR_TOP_K=10
MERGED_TOP_K=5

# 置信度评估阈值（严格策略）
HIGH_CONFIDENCE_SCORE=0.9
HIGH_CONFIDENCE_GAP=0.3
LOW_CONFIDENCE_SCORE=0.6
LOW_CONFIDENCE_GAP=0.1

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_evaluation.log
